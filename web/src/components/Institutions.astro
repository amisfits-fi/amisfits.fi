---
// Mukana olevat oppilaitokset – sama lista kaikilla kielillä (Sanity: institutionList).
// Nimet aakkosjärjestyksessä, kukin linkkinä oppilaitoksen kotisivulle.
// Linkit avautuvat uuteen välilehteen; ruudunlukija kertoo sen (tr.newTab).
import { t } from '@/lib/i18n'
import { urlFor } from '@/lib/sanity'
import type { Institution, Language } from '@/lib/queries'

interface Props {
  institutions: Institution[]
  lang:         Language
}

const { institutions, lang } = Astro.props
const tr = t(lang)

// Sivun kielen mukainen nimi ja kotisivu – tyhjä kenttä = suomenkielinen
const clean = (s?: string) => s?.trim() || ''
const nameFor = (i: Institution) => (lang === 'se' && clean(i.nameSv)) || clean(i.name)
const hrefFor = (i: Institution) =>
  (lang === 'se' && clean(i.urlSv)) || (lang === 'en' && clean(i.urlEn)) || clean(i.url)

// Aakkosjärjestys näkyvän nimen mukaan (å, ä ja ö aakkosten loppuun).
// Englanninkielisellä sivulla nimet ovat suomenkielisiä, joten suomen järjestys.
const collator = new Intl.Collator(lang === 'se' ? 'sv-FI' : 'fi-FI')

// Logo Sanityn kuvapalvelusta: SVG sellaisenaan, muut pienennettyinä kevyeen muotoon
const logoSrc = (i: Institution) => {
  const ref = i.logo?.asset?._ref
  if (!ref) return ''
  return ref.endsWith('-svg')
    ? urlFor(i.logo!).url()
    : urlFor(i.logo!).height(160).fit('max').auto('format').url()
}

const items = institutions
  .map((i) => ({ name: nameFor(i), href: hrefFor(i), logo: logoSrc(i) }))
  .filter((i) => i.name && /^https?:\/\//i.test(i.href))   // vain kokonaiset rivit
  .sort((a, b) => collator.compare(a.name, b.name))
---

{items.length > 0 && (
  <section class="institutions" aria-labelledby="institutions-heading">
    <div class="institutions__inner">
      <h2 class="institutions__heading" id="institutions-heading">{tr.institutionsHeading}</h2>

      <ul class="institutions__list" role="list">
        {items.map((i) => (
          <li class="institutions__item"><a href={i.href} target="_blank" rel="noopener noreferrer">{i.name}<span class="visually-hidden"> {tr.newTab}</span></a></li>
        ))}
      </ul>

      {/* KOKEILU 11/2026: logoruudukko nimilistan alla, jotta Sivista voi verrata
          vaihtoehtoja. Kun valinta on tehty, jätetään vain toinen. */}
      <ul class="institutions__logos" role="list">
        {items.map((i) => (
          <li>
            <a class="institutions__logo-link" href={i.href} target="_blank" rel="noopener noreferrer">
              {i.logo
                ? <img src={i.logo} alt={i.name} loading="lazy" decoding="async" />
                : <span class="institutions__logo-name">{i.name}</span>}
              <span class="visually-hidden"> {tr.newTab}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="institutions__more">
        <a href={tr.institutionsMoreUrl} target="_blank" rel="noopener noreferrer">{tr.institutionsMore}<span aria-hidden="true"> →</span><span class="visually-hidden"> {tr.newTab}</span></a>
      </p>
    </div>
  </section>
)}
