---
import type { Language, Audience } from '@/lib/queries'
import { AUDIENCES, LANGUAGES, LANG_LABEL, htmlLang, infoPath, pagePath, quizPath, t } from '@/lib/i18n'
import type { InfoPage } from '@/lib/i18n'
import CookieConsent from '@/components/CookieConsent.astro'
import '@/styles/global.css'

interface Props {
  lang:     Language
  audience: Audience
  title?:   string
  quiz?:    boolean   // testisivu: kieli- ja kohderyhmälinkit vievät vastaavaan testiin
  info?:    InfoPage  // tietosivu (seloste): kielilinkit vievät samaan selosteeseen, kohderyhmälinkit etusivuille
}

const { lang, audience, quiz = false, info } = Astro.props
const tr = t(lang)

const currentLabel = tr.audienceLabel[audience]

// Sama sivutyyppi (pääsivu tai testi) toisella kielellä / kohderyhmällä
const pathFor = (code: Language, aud: Audience) =>
  info ? infoPath(code, info) : quiz ? quizPath(code, aud) : pagePath(code, aud)

// Kohderyhmävalitsin – aina sama järjestys (nuoret, aikuiset), valittu korostetaan.
// Järjestys ei vaihdu valinnan mukaan (Sampsan palaute 23.10.2026).
const audiences = AUDIENCES.map((aud) => ({
  label:  tr.audienceLabel[aud],
  href:   info ? pagePath(lang, aud) : pathFor(lang, aud),
  active: !info && aud === audience,
}))

// Kielivalitsin – sama kohderyhmä, eri kieli (kunkin kielen oma slug)
const languages = LANGUAGES.map((code) => ({
  code,
  label: LANG_LABEL[code],
  href:  pathFor(code, audience),
}))

// ── Otsikko ja jakotiedot (Facebook, LinkedIn, WhatsApp, X) ─────────────────
// Osoitteet muodostetaan astro.config.mjs:n site-asetuksesta: kun amisfits.fi
// kytketään, ne vaihtuvat automaattisesti oikeaan domainiin.
const title      = Astro.props.title ?? `${tr.slogan} – ${currentLabel} | amisfits.fi`
const shareTitle = Astro.props.title ?? `${tr.slogan} | amisfits.fi`
const canonical  = new URL(pathFor(lang, audience), Astro.site).href
const ogImage    = new URL(`/og/og-${htmlLang(lang)}.png`, Astro.site).href
const alternates = LANGUAGES.map((code) => ({
  hreflang: htmlLang(code),
  href:     new URL(pathFor(code, audience), Astro.site).href,
}))
const xDefault = new URL(pathFor('fi', audience), Astro.site).href
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={tr.metaDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />

    <meta property="og:type"         content="website" />
    <meta property="og:site_name"    content="amisfits.fi" />
    <meta property="og:locale"       content={tr.ogLocale} />
    <meta property="og:title"        content={shareTitle} />
    <meta property="og:description"  content={tr.metaDescription} />
    <meta property="og:url"          content={canonical} />
    <meta property="og:image"        content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={tr.themeAlt[1]} />
    <meta name="twitter:card"        content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Rubik omalta palvelimelta: latin-osa haetaan heti, jotta fontti on käytössä mahdollisimman nopeasti -->
    <link rel="preload" href="/fonts/rubik-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- CSS injected by Astro via import in frontmatter -->
  </head>

  <body>
    <!-- ── Navigaatio ───────────────────────────────────────── -->
    <nav class="nav">
      <div class="nav__audiences">
        {audiences.map((a) => a.active
          ? <span class="nav__audience nav__audience--active" aria-current="page">{a.label}</span>
          : <a class="nav__audience" href={a.href}>{a.label}</a>
        )}
      </div>

      <div class="nav__languages">
        {languages.map(l => (
          <a
            class:list={['nav__lang', { 'nav__lang--active': l.code === lang }]}
            href={l.href}
            hreflang={htmlLang(l.code)}
            lang={htmlLang(l.code)}
          >{l.label}</a>
        ))}
      </div>
    </nav>

    <!-- ── Pääsisältö ───────────────────────────────────────── -->
    <main>
      <slot />
    </main>

    <!-- ── Footer ───────────────────────────────────────────── -->
    <footer class="footer">
      <div class="footer__inner">
        <div>
          <p class="footer__wordmark">amisfits</p>
        </div>
        <div>
          <p class="footer__text">
            {tr.footerPre}
            <a href="https://www.sivista.fi" target="_blank" rel="noopener noreferrer" style="color: inherit;">
              Sivistysala ry (Sivista)<span class="visually-hidden"> {tr.newTab}</span>
            </a>
            {tr.footerPost}
          </p>
          <p class="footer__text footer__links">
            <a href={infoPath(lang, 'privacy')} style="color: inherit;">{tr.privacyLink}</a>
            <a href={infoPath(lang, 'accessibility')} style="color: inherit;">{tr.accessibilityLink}</a>
          </p>
          <!-- Näkyy vain, kun Analytics on käytössä (CookieConsent paljastaa linkin) -->
          <p class="footer__text footer__consent" hidden data-consent-open>
            <a href="#" style="color: inherit;">{tr.consentSettings}</a>
          </p>
        </div>
      </div>
    </footer>

    <CookieConsent lang={lang} />
  </body>
</html>
