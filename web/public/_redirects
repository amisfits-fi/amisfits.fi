# Netlify-uudelleenohjaukset
# i18n-kierros lokalisoi audience-slugit. Vanhat suomenkieliset slugit
# ruotsin/englannin reiteillä ohjataan pysyvästi (301) uusiin osoitteisiin.
# (Suomen reitit /fi/nuoret ja /fi/aikuiset eivät muuttuneet.)

# Ruotsi: nuoret → unga, aikuiset → vuxna.
# Lisäksi kielikoodi korjattu: /se/ (pohjoissaame) → /sv/ (ruotsi, ISO 639-1).
/se/nuoret       /sv/unga    301!
/se/nuoret/      /sv/unga/   301!
/se/aikuiset     /sv/vuxna   301!
/se/aikuiset/    /sv/vuxna/  301!
/se/*            /sv/:splat  301!

# Englanti: nuoret → youth, aikuiset → adults
/en/nuoret       /en/youth   301!
/en/nuoret/      /en/youth/  301!
/en/aikuiset     /en/adults  301!
/en/aikuiset/    /en/adults/ 301!

# ── Kielen juuri → kielen nuorten sivu (ennen 404) ──────────────────────────
# Netlify normalisoi kauttaviivan: /fi ja /fi/ ohjautuvat molemmat.
/fi              /fi/nuoret/          301
/sv              /sv/unga/            301
/en              /en/youth/           301

# ── Testin lyhytosoitteet (QR-koodit, pöytäkolmiot, flyerit) ─────────────────
# 302 = tilapäinen: kohteen voi vaihtaa myöhemmin ilman että selaimet ovat
# välimuistittaneet vanhan ohjauksen. Painettuja QR-koodeja ei tarvitse uusia.
# Netlify normalisoi kauttaviivan, joten /testi-nuoret ja /testi-nuoret/ toimivat.
/testi-nuoret    /fi/nuoret/testi/    302
/testi-aikuiset  /fi/aikuiset/testi/  302
/testet-unga     /sv/unga/testet/     302
/testet-vuxna    /sv/vuxna/testet/    302
/test-youth      /en/youth/test/      302
/test-adults     /en/adults/test/     302
