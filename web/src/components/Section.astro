---
import { renderPT } from '@/lib/portable'
import { urlFor, imageDims } from '@/lib/sanity'
import { t, quizPath } from '@/lib/i18n'
import type { Section, Audience, Language } from '@/lib/queries'

interface Props {
  section:  Section
  audience: Audience
  lang:     Language
  index?:   number   // 0 = sivun ensimmäinen sektio (H1-otsikko, kuva latautuu heti)
}

const { section, audience, lang, index = 0 } = Astro.props
const isFirst = index === 0
const tr = t(lang)

// ── Audience-ehtologiikka – valitaan oikea sisältö ───────────────────────────
// Sanityn valinta "Käytä nuorten tekstiä myös aikuisille" ohittaa aikuisten kentät.
const useYouth = audience === 'nuoret' || section.sameAsYouth === true

const summary = useYouth ? section.summaryYouth     : section.summaryAdult
const uas     = useYouth ? section.expandedYouth    : section.expandedAdult     // polku ammattikorkeakouluun
const uni     = useYouth ? section.expandedYouthUni : section.expandedAdultUni  // polku yliopistoon

// Ensimmäisessä osiossa osion otsikko on sivun H1, joten väliotsikot nousevat tason (H2, H3)
const pt = { headingShift: isFirst }
const summaryHTML = renderPT(summary, lang, pt)
const uasHTML     = renderPT(uas, lang, pt)
const uniHTML     = renderPT(uni, lang, pt)

// Polkupainikkeiden lokalisoidut otsikot
// hidePaths = Sanityn valinta "Piilota polkupainikkeet" (esim. yleisluontoinen aloitusosio)
const paths = section.hidePaths
  ? []
  : [
      { label: tr.pathUas, html: uasHTML },
      { label: tr.pathUni, html: uniHTML },
    ].filter((p) => p.html)

// Taustaväri CSS-luokkana
const bgClass = `section--${section.backgroundColor}` // section--pink / section--yellow / section--blue

// Näyttöotsikko SVG -tiedostomapping, kielikohtainen
// Tiedostot ovat Berryn kampanja-aineiston kärkiviesteja, sama grafiikka kolmella kielella.
// Nimeamiskaava: teema<1-3>_<desktop|mobiili>_<fi|se|en>.svg
// Mitat: desktop 820x350 (vaaka), mobiili 440x520 (pysty).
// HUOM: numero viittaa kampanja-aineiston tietoiskunumeroon, ei sektion jarjestykseen sivulla.
//   1 = Amis antaa suunnan (pink) | 2 = Amis avaa ovia (yellow) | 3 = Amis aktivoi unelmasi (blue)
const themeGraphicNumber: Record<string, 1 | 2 | 3> = {
  pink:   1,
  yellow: 2,
  blue:   3,
}
const graphicNumber = section.backgroundColor
  ? themeGraphicNumber[section.backgroundColor]
  : undefined
const graphic = graphicNumber
  ? {
      desktop: `/images/teema${graphicNumber}_desktop_${lang}.svg`,
      mobile:  `/images/teema${graphicNumber}_mobiili_${lang}.svg`,
    }
  : undefined

// Grafiikan alt-teksti = grafiikan koko teksti (i18n.ts), ei vain Sanityn lyhyt näyttöotsikko
const graphicAlt = graphicNumber ? tr.themeAlt[graphicNumber] : (section.displayHeadline ?? '')
// Ensimmäinen grafiikka näkyy heti sivun auetessa: ei viivästettyä latausta
const imgLoading  = isFirst ? 'eager' : 'lazy'
const imgPriority = isFirst ? 'high' : 'auto'
// Grafiikan otsikkotaso: sivun ensimmäinen on sivun H1, muut osio-otsikoita (H2).
// Grafiikka on osion näkyvä otsikko, joten myös "Amis avaa ovia" ja "Amis aktivoi
// unelmasi" kuuluvat ruudunlukijan otsikkolistaan (WCAG 1.3.1).
const GraphicTag  = isFirst ? 'h1' : 'h2'

// Kohderyhmän video: aikuisille oma video, jos sellainen on, muuten nuorten video.
// Jos videota ei ole, videopaikkaa ei näytetä lainkaan.
const videoUrl = audience === 'aikuiset' ? (section.videoAdult || section.video) : section.video

// YouTube-video: tukee osoitemuotoja watch?v=ID, youtu.be/ID, /embed/ID ja /shorts/ID.
// Sivulle tulee aluksi vain videon pikkukuva ja toistopainike. YouTuben soitin
// (yli 500 kt JavaScriptiä) ladataan vasta, kun kävijä painaa painiketta: sivu
// aukeaa nopeammin, eikä YouTubeen oteta yhteyttä soittimen osalta ennen toistoa.
// Upotus käyttää tavallista youtube.com-osoitetta: evästeetön youtube-nocookie.com
// pysäytti osan kävijöistä YouTuben "Sign in to confirm you're not a bot"
// -tarkistukseen (20.11.2026). YouTube voi asettaa evästeitä, kun video käynnistetään;
// tämä on kerrottu tietosuojaselosteessa.
// rel=0 = videon lopussa ehdotetaan vain saman kanavan videoita.
// Ilman JavaScriptiä painike on tavallinen linkki videoon YouTubessa.
const ytId = videoUrl?.match(/(?:v=|youtu\.be\/|\/embed\/|\/shorts\/)([A-Za-z0-9_-]{11})/)?.[1]
const video = ytId
  ? {
      embed:    `https://www.youtube.com/embed/${ytId}?rel=0&autoplay=1`,
      watch:    `https://www.youtube.com/watch?v=${ytId}`,
      thumb:    `https://i.ytimg.com/vi/${ytId}/maxresdefault.jpg`,
      fallback: `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`,
    }
  : undefined
const videoTitle = `Video: ${tr.slogan}`

// Tiedostokoko luettavaan muotoon
function fmtSize(bytes?: number): string {
  if (!bytes) return ''
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} kB`
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
}
---

{/* ── Värillinen sektio ─────────────────────────────────────── */}
<section class={`section ${bgClass}`}>

  {/* Näyttöotsikko SVG – section__innerin ulkopuolella, vuotaa symmetrisesti molemmille puolille */}
  {graphic && (
    <div class="section__display-graphic">
      <GraphicTag class="section__display-heading">
      {graphic.mobile ? (
        /* Desktop + mobiili eri kuva — <picture> lataa vain tarvittavan */
        <picture>
          <source media="(min-width: 641px)" srcset={graphic.desktop} width="820" height="350" />
          <img
            src={graphic.mobile}
            alt={graphicAlt}
            width="440"
            height="520"
            class="section__display-img"
            loading={imgLoading}
            fetchpriority={imgPriority}
            decoding="async"
          />
        </picture>
      ) : (
        /* Yksi kuva kaikille näytöille */
        <img
          src={graphic.desktop}
          alt={graphicAlt}
          width="820"
          height="350"
          class="section__display-img"
          loading={imgLoading}
          fetchpriority={imgPriority}
          decoding="async"
        />
      )}
      </GraphicTag>
    </div>
  )}

  <div class="section__inner">

    {/* YouTube-video (valinnainen) – tyhjänä videopaikkaa ei näytetä */}
    {videoUrl && (
      <div class="section__video-area">
        {video ? (
          <>
          <div class="section__video" data-video data-embed={video.embed} data-title={videoTitle}>
            <a class="section__video-link" href={video.watch} data-video-play>
              <img
                src={video.thumb}
                data-fallback={video.fallback}
                alt=""
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <span class="section__video-play" aria-hidden="true"></span>
              <span class="visually-hidden">{tr.playVideo}: {tr.slogan}</span>
            </a>
          </div>
          <p class="section__video-alt">
            <a href={video.watch} target="_blank" rel="noopener noreferrer">{tr.watchOnYoutube}<span class="visually-hidden"> {tr.newTab}</span></a>
          </p>
          </>
        ) : (
          /* Muu kuin YouTube-osoite: upotetaan sellaisenaan */
          <div class="section__video">
            <iframe
              src={videoUrl}
              title={videoTitle}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            />
          </div>
        )}
      </div>
    )}

    {/* Iso sisältöotsikko – piilotetaan jos tyhjä */}
    {section.headline && (
      <h2 class="section__headline">{section.headline}</h2>
    )}

    {/* Tiivistelmä – aina näkyvissä */}
    {summaryHTML && (
      <div class="section__summary" set:html={summaryHTML} />
    )}

    {/* Polkupainikkeet – AMK ja yliopisto erillisinä haitareina (natiivi HTML, ei JS) */}
    {paths.length > 0 && (
      <div class="section__paths">
        {paths.map((p) => (
          <details class="section__details">
            <summary class="section__cta">
              <span class="section__cta-pill">
                {p.label}
                <i class="section__cta-icon" aria-hidden="true">▾</i>
              </span>
            </summary>
            <div class="section__expanded" set:html={p.html} />
          </details>
        ))}
      </div>
    )}

    {/* Erilliset kuvat (valinnainen) */}
    {section.images && section.images.length > 0 && (
      <div class="section__images">
        {section.images.map((img) => (
          <figure class="section__image">
            <img
              src={urlFor(img).width(1200).fit('max').auto('format').url()}
              alt={img.alt ?? ''}
              {...imageDims(img, 1200)}
              loading="lazy"
              decoding="async"
            />
            {img.alt && <figcaption class="section__image-caption">{img.alt}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {/* Erilliset tiedostoliitteet (valinnainen) */}
    {section.attachments && section.attachments.length > 0 && (
      <ul class="section__attachments">
        {section.attachments.map((att) => (
          att.asset?.url && (
            <li>
              <a class="section__attachment" href={att.asset.url} download>
                <span class="section__attachment-icon" aria-hidden="true">📎</span>
                <span>{att.title ?? att.asset.originalFilename ?? 'Lataa tiedosto'}</span>
                {(att.asset.extension || att.asset.size) && (
                  <span class="section__attachment-meta">
                    {att.asset.extension ? att.asset.extension.toUpperCase() : ''}{att.asset.extension && att.asset.size ? ' · ' : ''}{fmtSize(att.asset.size)}
                  </span>
                )}
              </a>
            </li>
          )
        ))}
      </ul>
    )}

    {/* AMISFITS-testi CTA – selkeä painike.
        testCtaUrl (Sanity) voi ohjata muualle; tyhjänä käytetään
        sivuston omaa testisivua (/fi/nuoret/testi jne.) */}
    <div class="section__test">
      <p class="section__test-lead">{tr.testLead}</p>
      <a href={section.testCtaUrl || quizPath(lang, audience)} class="section__test-button">{tr.testButton}</a>
    </div>

  </div>
</section>

<script>
  // Videon toistopainike: vaihtaa pikkukuvan tilalle YouTube-soittimen ja käynnistää videon.
  document.querySelectorAll<HTMLAnchorElement>('[data-video-play]').forEach((link) => {
    // Jos videolla ei ole täysikokoista pikkukuvaa, YouTube palauttaa 120 px:n
    // paikkamerkin. Silloin vaihdetaan pienempään kuvaan, joka on aina olemassa.
    const img = link.querySelector('img')
    const checkThumb = () => {
      if (img && img.naturalWidth > 0 && img.naturalWidth <= 120 && img.dataset.fallback) {
        const fallback = img.dataset.fallback
        delete img.dataset.fallback
        img.src = fallback
      }
    }
    if (img) {
      if (img.complete) checkThumb()
      img.addEventListener('load', checkThumb)
    }

    link.addEventListener('click', (e) => {
      const box = link.closest<HTMLElement>('[data-video]')
      const src = box?.dataset.embed
      if (!box || !src) return   // ei upotusosoitetta: linkki vie YouTubeen
      e.preventDefault()
      const frame = document.createElement('iframe')
      frame.src = src
      frame.title = box.dataset.title ?? ''
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      frame.referrerPolicy = 'strict-origin-when-cross-origin'
      frame.allowFullscreen = true
      box.replaceChildren(frame)
      frame.focus()
    })
  })
</script>
