---
import Layout        from '@/layouts/Layout.astro'
import Section       from '@/components/Section.astro'
import FaqAccordion  from '@/components/FaqAccordion.astro'
import Institutions  from '@/components/Institutions.astro'
import { getOnePager, getInstitutions } from '@/lib/queries'
import type { Language, Audience } from '@/lib/queries'
import { LANGUAGES, AUDIENCES, audienceSlug, pathLang } from '@/lib/i18n'

// ── Staattinen reittilistaus – lokalisoidut audience-slugit per kieli ─────────
// Esim. /fi/nuoret, /sv/unga, /en/youth. URL:ssä käytetään ISO-kielikoodia
// (pathLang); Sanityn sisäinen koodi ja kanoninen audience välitetään propseina.
export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    AUDIENCES.map((audience) => ({
      params: { lang: pathLang(lang), audience: audienceSlug(lang, audience) },
      props:  { lang, audience },
    }))
  )
}

// ── Hae Sanitystä oikea dokumentti ja yhteinen oppilaitoslista ───────────────
const { lang, audience } = Astro.props as { lang: Language; audience: Audience }
const [page, institutions] = await Promise.all([getOnePager(lang), getInstitutions()])
---

<Layout lang={lang} audience={audience}>

  {/* Sektiot – audience-ehtologiikka tapahtuu Section-komponentissa */}
  {page.sections.map((section, index) => (
    <Section section={section} audience={audience} lang={lang} index={index} />
  ))}

  {/* FAQ-haitari */}
  {page.faq?.length > 0 && (
    <FaqAccordion items={page.faq} audience={audience} lang={lang} />
  )}

  {/* Mukana olevat oppilaitokset – sama lista kaikilla kielillä */}
  {institutions.length > 0 && (
    <Institutions institutions={institutions} lang={lang} />
  )}

</Layout>
